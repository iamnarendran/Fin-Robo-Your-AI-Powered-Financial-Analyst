# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- AI analyst (shared key so visitors need no setup) ---------------------
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional fallback if no Gemini key is set: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional model overrides (free-tier model names change often).
# FINROBO_GEMINI_MODEL=gemini-flash-latest
# FINROBO_OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Requests per IP per 10 minutes on the shared key (default 20).
# Visitors who add their own key in AI settings are not limited.
# FINROBO_RATE_LIMIT=20

# --- Development -----------------------------------------------------------
# Serve deterministic synthetic market data AND a scripted demo AI model.
# No network or API keys needed. Leave unset in production.
# FINROBO_MOCK=1
